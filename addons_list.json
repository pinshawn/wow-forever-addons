{
  "說明": "插件自動更新（v1.3 起）每次都會先讀這份清單：這裡新加的插件會自己加進每個人的更新清單；跟本機 addons.json 同一個主資料夾的，用這裡的寫法。type：github-release＝作者在 GitHub 發布版本；github-branch＝作者把每一版放在 GitHub 分支（看 .toc 的版本號）；json-manifest＝作者自己網站公布的版本清單（有版本號、下載網址、檢查碼）；manual＝只在 CurseForge，要自己按下載，下載好再雙擊一次會從「下載」資料夾自動裝；own＝自己做的，不檢查。autoInstall＝沒裝也幫你裝；needs＝要先有哪個插件才裝。github-source＝作者 GitHub 只有原始碼的（例：Details）：從作者 GitHub 下載原始碼自己組裝（搬附加資料夾、填版本號），不經過 CurseForge。github-tag＝作者每一版在 GitHub 打版本標籤（例：ProcDoc）：照最新的標籤下載、填版本號（v1.3.8 起）。optional＝給要的人用的：installMissing 也不會自己裝，自己先放一次之後才幫你更新（v1.3.8 起）。",
  "notice": "",
  "updater": {
    "version": "1.3.8",
    "files": [
      {
        "path": "插件更新/update_addons.ps1",
        "url": "https://raw.githubusercontent.com/pinshawn/wow-forever-addons/main/updater/update_addons.ps1",
        "sha256": "70f24289dda42fe3682f67c859969455a622778a2694f1198cad4933429ab29a"
      }
    ],
    "notes": [
      "v1.3.8：新增 ProcDoc（觸發特效時畫面跳出大圖案，每個職業都有）；可以照作者 GitHub 的「版本標籤」下載；清單上標 optional 的插件不會自己裝",
      "v1.3.7：Details 直接從作者 GitHub 下載、自己組裝、自己更新，完全不經過 CurseForge；另外會一起裝我們自己翻的 Details 繁體中文",
      "v1.3.6：可以收「共用補丁」（我們修好的別人插件的問題），朋友雙擊就會自己補上；作者自己修好了，補丁就停用、用作者的",
      "v1.3.5：更新程式以後會自己更新，不用再拿新的一包"
    ]
  },
  "patches": [
    {
      "id": "df-class-simtab",
      "name": "無限副本手冊 職業模組：「天賦模擬」改成自己的按鈕（打怪中按 N 不再被擋）",
      "url": "https://raw.githubusercontent.com/pinshawn/wow-forever-addons/main/patches/df-class-simtab.json",
      "sha256": "9a18f53e2ae30c15b2b28c1ec0aa2e2a2b5a5f7d66ee22dbab4723602e244672"
    }
  ],
  "addons": [
    {
      "name": "Questie（含 QuestieDB）",
      "type": "github-release",
      "repo": "Questie/Questie",
      "asset": "^Questie-.*\\.zip$",
      "folders": [
        "Questie",
        "QuestieDB"
      ]
    },
    {
      "name": "Shortest Path Forever",
      "type": "github-release",
      "repo": "cjber/shortest-path-forever",
      "asset": "-forever\\.zip$",
      "folders": [
        "ShortestPathForever",
        "ForeverCore"
      ]
    },
    {
      "name": "OneForAll",
      "type": "github-branch",
      "repo": "smoergi/OneForAll_Forever",
      "branch": "main",
      "toc": "OneForAll/OneForAll.toc",
      "folders": [
        "OneForAll"
      ]
    },
    {
      "name": "DungeonsForever（無限副本手冊，8 個模組）",
      "type": "github-branch",
      "repo": "ayuanbro/DungeonsForever",
      "branch": "master",
      "toc": "DungeonsForever/DungeonsForever.toc",
      "folders": [
        "DungeonsForever",
        "DungeonsForeverClass",
        "DungeonsForeverExplore",
        "DungeonsForeverFaction",
        "DungeonsForeverGear",
        "DungeonsForeverProf",
        "DungeonsForeverPvP",
        "DungeonsForeverSpell"
      ]
    },
    {
      "name": "GearInsight Forever",
      "type": "json-manifest",
      "manifest": [
        "https://gearinsight.app/static/data/releases.json",
        "https://gearinsight.cn/static/data/releases.json"
      ],
      "key": "forever_v2",
      "folders": [
        "GearInsight_Forever",
        "GearInsight_Forever_Group",
        "GearInsight_Forever_Guild"
      ]
    },
    {
      "name": "有愛黑體切換（含字型）",
      "type": "github-branch",
      "repo": "pinshawn/wow-forever-addons",
      "branch": "main",
      "toc": "AAA_NowarSansSwitch/AAA_NowarSansSwitch.toc",
      "folders": [
        "AAA_NowarSansSwitch"
      ],
      "autoInstall": true
    },
    {
      "name": "OneForAll 繁體中文包",
      "type": "github-branch",
      "repo": "pinshawn/wow-forever-addons",
      "branch": "main",
      "toc": "OneForAll_zhTW/OneForAll_zhTW.toc",
      "folders": [
        "OneForAll_zhTW"
      ],
      "needs": [
        "OneForAll"
      ],
      "autoInstall": true
    },
    {
      "name": "Questie 只顯示這一區",
      "type": "github-branch",
      "repo": "pinshawn/wow-forever-addons",
      "branch": "main",
      "toc": "QuestieZoneOnly/QuestieZoneOnly.toc",
      "folders": [
        "QuestieZoneOnly"
      ],
      "needs": [
        "Questie"
      ],
      "autoInstall": true
    },
    {
      "name": "Details!（傷害統計，8 個資料夾）",
      "type": "github-source",
      "repo": "Tercioo/Details-Damage-Meter",
      "branch": "master",
      "check": {
        "file": "boot.lua",
        "pattern": "build_counter\\s*=\\s*(\\d+)"
      },
      "layout": {
        "Details": "",
        "Details_DataStorage": "plugins/Details_DataStorage",
        "Details_EncounterDetails": "plugins/Details_EncounterDetails",
        "Details_RaidCheck": "plugins/Details_RaidCheck",
        "Details_Streamer": "plugins/Details_Streamer",
        "Details_TinyThreat": "plugins/Details_TinyThreat",
        "Details_Vanguard": "plugins/Details_Vanguard",
        "Details_Compare2": "plugins/Details_Compare2"
      },
      "keepIfStub": [
        "Details\\locales\\Details-zhTW.lua",
        "Details\\locales\\Details-zhCN.lua"
      ],
      "folders": [
        "Details",
        "Details_DataStorage",
        "Details_EncounterDetails",
        "Details_RaidCheck",
        "Details_Streamer",
        "Details_TinyThreat",
        "Details_Vanguard",
        "Details_Compare2"
      ],
      "autoInstall": true
    },
    {
      "name": "Details! 繁體中文（我們自己翻的）",
      "type": "github-branch",
      "repo": "pinshawn/wow-forever-addons",
      "toc": "!Details_zhTW/!Details_zhTW.toc",
      "folders": [
        "!Details_zhTW"
      ],
      "needs": [
        "Details"
      ],
      "autoInstall": true
    },
    {
      "name": "ProcDoc（觸發提示，每個職業都有）",
      "type": "github-tag",
      "repo": "wsmaxcy/ProcDoc",
      "folders": [
        "ProcDoc"
      ],
      "autoInstall": true
    }
  ]
}
